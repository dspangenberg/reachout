{
  "name": "gtkx-outreach",
  "version": "0.0.3",
  "private": true,
  "license": "EUPL-1.2",
  "description": "Outreach – Contact manager",
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "gtkx dev",
    "build": "gtkx build",
    "codegen": "gtkx codegen",
    "test": "vitest run && npm run test:i18n",
    "test:i18n": "gtkx build && vitest run --config vitest.i18n.config.ts",
    "db:generate": "drizzle-kit generate && node scripts/generate-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "gtkx codegen && tsc",
    "lint": "biome check .",
    "start": "node dist/bundle.mjs",
    "deploy": "gtkx deploy"
  },
  "dependencies": {
    "@gtkx/cairo": "^2.0.0-beta.5",
    "@gtkx/components": "^2.0.0-beta.5",
    "@gtkx/css": "^2.0.0-beta.5",
    "@gtkx/forms": "^2.0.0-beta.5",
    "@gtkx/i18n": "^2.0.0-beta.5",
    "@gtkx/navigation": "^2.0.0-beta.5",
    "@gtkx/react": "^2.0.0-beta.5",
    "@gtkx/runtime": "^2.0.0-beta.5",
    "@react-navigation/core": "^7.21.13",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@gtkx/cli": "^2.0.0-beta.5",
    "@gtkx/config": "^2.0.0-beta.5",
    "@gtkx/testing": "^2.0.0-beta.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "author": "GTKX <hello@gtkx.dev>",
  "homepage": "https://gtkx.dev"
}
