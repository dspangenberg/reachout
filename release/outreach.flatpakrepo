[Flatpak Repo]
Title=Outreach
Name=outreach
Url=https://dspangenberg.github.io/outreach
Homepage=https://github.com/dspangenberg/outreach
Comment=Outreach – Contact manager
Description=Outreach, ein Kontakt- und Aufgabenmanager für GNOME
GPGKey=PASTE_BASE64_GPG_KEY_HERE_UNWRAPPED

# Dies ist die Ausgangsvorlage. Publish.sh erzeugt die ausgelieferte
# outreach.flatpakrepo mit dem echten, Base64-kodierten Signier-Key automatisch
# im Repo-Ausgabeverzeichnis (release/repo).
# Installation auf einem Endgerät (Schlüssel wird automatisch importiert):
#   flatpak remote-add --if-not-exists outreach https://dspangenberg.github.io/outreach/outreach.flatpakrepo
#   flatpak install --user outreach de.twiceware.outreach